modules/*/android/build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Google Play / release credentials (never commit private keys)
google-play-service-account*.json
service-account*.json
.release-secrets/

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

