default_platform(:android)

platform :android do
  private_lane :upload_test_release do |options|
    aab_path = ENV.fetch("ANDROID_AAB_PATH")
    json_key = ENV.fetch("GOOGLE_PLAY_JSON_KEY")

    UI.user_error!("AAB bulunamadı: #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Google Play JSON anahtarı bulunamadı") unless File.exist?(json_key)

    upload_to_play_store(
      package_name: "com.triworkster.trinkow",
      json_key: json_key,
      aab: aab_path,
      track: options.fetch(:track),
      release_status: options.fetch(:release_status),
      version_name: ENV.fetch("ANDROID_VERSION_NAME"),
      in_app_update_priority: 5,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      timeout: 600
    )
  end

  desc "Native AAB'yi Google Play internal testing kanalında yayınlar"
  lane :internal do
    upload_test_release(track: "internal", release_status: "completed")
  end

  desc "Native AAB'yi Google Play kapalı test kanalına taslak olarak gönderir"
  lane :closed do
    upload_test_release(track: "alpha", release_status: "draft")
  end
end
