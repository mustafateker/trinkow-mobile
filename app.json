{
  "expo": {
    "name": "Trinkow",
    "slug": "trinkow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "trinkow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#071A70",
    "developmentClient": {
      "silentLaunch": true
    },
    "icon": "./assets/images/trinkow-app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trinkow.app"
    },
    "android": {
      "package": "com.triworkster.trinkow",
      "versionCode": 1,
      "backgroundColor": "#171C42",
      "adaptiveIcon": {
        "backgroundColor": "#071A70",
        "foregroundImage": "./assets/images/trinkow-android-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A70",
          "image": "./assets/images/trinkow-brand-mark.png",
          "imageWidth": 176,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
