{
  "expo": {
    "name": "Trinkow",
    "slug": "trinkow",
    "version": "0.1.15",
    "orientation": "default",
    "scheme": "trinkow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#071A70",
    "developmentClient": {
      "silentLaunch": true
    },
    "icon": "./assets/images/trinkow-app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.triworkster.trinkow",
      "buildNumber": "17",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Trinkow'un harcama fişi veya profil görseli seçebilmeniz için fotoğraf arşivinize erişmesine izin verin.",
        "NSPhotoLibraryAddUsageDescription": "Trinkow'un bütçe ve harcama özeti görsellerini fotoğraf arşivinize kaydedebilmesine izin verin.",
        "NSFaceIDUsageDescription": "Trinkow'un güvenli oturum bilgilerinizi korumak için Face ID kullanmasına izin verin."
      }
    },
    "android": {
      "package": "com.triworkster.trinkow",
      "versionCode": 16,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "backgroundColor": "#171C42",
      "adaptiveIcon": {
        "backgroundColor": "#071A70",
        "foregroundImage": "./assets/images/trinkow-android-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071A70",
          "image": "./assets/images/trinkow-brand-mark.png",
          "imageWidth": 176,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Trinkow'un sesli harcama eklemek için mikrofonu kullanmasına izin ver.",
          "speechRecognitionPermission": "Trinkow'un söylediklerini harcama alanlarına dönüştürmesine izin ver.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "VoiceExpense",
              "displayName": "Sesli harcama",
              "description": "Trinkow'da sesle hızlı harcama ekle.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "VoiceExpense",
              "label": "Sesli harcama",
              "description": "Trinkow'da sesle hızlı harcama ekle",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "tr",
            "de",
            "fr",
            "es",
            "it",
            "pt",
            "ro",
            "pl",
            "ru",
            "cs"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
