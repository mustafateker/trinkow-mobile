# Boş bırakıldığında Expo bilgisayarının adresi otomatik seçilir.
# Gerçek telefon için 127.0.0.1 kullanma; bilgisayarın LAN IP'sini kullan.
# EXPO_PUBLIC_API_URL=http://192.168.1.22:8000

# Yalnız geliştirmede ayrı "Test hesabıyla devam et" seçeneğini gösterir.
# Normal e-posta/şifre formu bu ayardan bağımsız olarak gerçek kimlik doğrular.
# Üretim derlemesinde test seçeneği daima kapalıdır.
EXPO_PUBLIC_DEV_LOGIN=1
