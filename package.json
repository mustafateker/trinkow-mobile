{
  "name": "trinkow",
  "main": "index.js",
  "version": "0.1.7",
  "private": true,
  "scripts": {
    "dev": "python3 ../dev.py",
    "test": "node --test tests/*.test.cjs",
    "start": "expo start -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm test",
    "release:setup": "node scripts/release-setup.mjs",
    "release": "node scripts/release.mjs",
    "release:internal": "node scripts/release.mjs internal",
    "release:closed": "node scripts/release.mjs closed"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets"
        ]
      }
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.26",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-in-app-updates": "^0.12.0",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.27",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.23.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3"
  }
}
