<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
  <application>
    <service
        android:name="expo.modules.trinkowquickaccess.VoiceExpenseTileService"
        android:exported="true"
        android:icon="@drawable/ic_trinkow_mic"
        android:label="@string/quick_access_voice_expense"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <activity
        android:name="com.triworkster.trinkow.MainActivity"
        tools:node="merge">
      <meta-data
          android:name="android.app.shortcuts"
          android:resource="@xml/trinkow_shortcuts" />
    </activity>
  </application>
</manifest>
